import math

R = float(input("Введіть зовнішній радіус (R): "))
r = float(input("Введіть внутрішній радіус (r): "))

if R > r > 0:
    area = math.pi * (R**2 - r**2)
    print(f"Площа кільця: {area:.2f}")
elif r >= R:
    print("Помилка: Зовнішній радіус має бути більшим за внутрішній!")
else:
    print("Радіуси повинні бути додатними!")
